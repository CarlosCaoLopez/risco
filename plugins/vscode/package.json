{
  "name": "risco",
  "displayName": "Risco",
  "description": "Muestra en la vista previa de Markdown los subrayados hechos con Risco.",
  "publisher": "risco",
  "version": "0.1.0",
  "engines": { "vscode": "^1.90.0" },
  "categories": ["Other"],
  "main": "./extension.js",
  "activationEvents": ["onLanguage:markdown"],
  "contributes": {
    "markdown.markdownItPlugins": true,
    "markdown.previewScripts": ["./preview.js"],
    "markdown.previewStyles": ["./liquid-highlight.css"]
  }
}
