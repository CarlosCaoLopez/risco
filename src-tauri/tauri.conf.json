{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Risco",
  "mainBinaryName": "risco",
  "version": "0.2.0",
  "identifier": "app.risco",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "macOSPrivateApi": true,
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Subraya Markdown desde cualquier visor",
    "longDescription": "Mantén Ctrl y arrastra sobre el texto de cualquier visor de Markdown para subrayarlo con un rotulador de cristal líquido.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": { "depends": ["libayatana-appindicator3-1", "libxtst6"] },
      "rpm": { "depends": ["libayatana-appindicator-gtk3", "libXtst"] }
    },
    "macOS": { "minimumSystemVersion": "11.0", "hardenedRuntime": true }
  }
}
